# Azure Speech service (speech-to-text). Copy to backend/.env and fill in real values.
# Get these from the Azure portal: Speech resource -> Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# LLM (DeepSeek, OpenAI-compatible). Get a key at platform.deepseek.com.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
